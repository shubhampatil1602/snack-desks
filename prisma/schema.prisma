generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String      @id
  name                String
  email               String
  emailVerified       Boolean     @default(false)
  image               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  sessions            Session[]
  accounts            Account[]
  role                String      @default("user")
  members             Member[]
  orders              Order[]
  appliedReplacements OrderItem[] @relation("ReplacementAppliedBy")

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  wonWindows OrderWindow[] @relation("OrderWindowWinner")
  adminCreatedOrders Order[] @relation("AdminCreatedOrders")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id              String   @id
  name            String
  slug            String   @unique
  logo            String?
  createdAt       DateTime
  metadata        String?
  inviteCode      String   @unique
  realtimeEnabled Boolean  @default(true)

  members        Member[]
  invitations    Invitation[]
  orders         Order[]
  menuItems      MenuItem[]
  orderWindows   OrderWindow[]
  menuCategories MenuCategory[]
  shops          Shop[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 String
  canViewGlobalSplit   Boolean      @default(false)
  createdAt            DateTime

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime?

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model OrderWindow {
  id             String @id
  organizationId String

  label     String // "tea" | "lunch" | "evening" | anything admin types
  status    String // "active" | "closed"
  startsAt  DateTime
  endsAt    DateTime?
  createdBy String // userId of admin who started it
  createdAt DateTime  @default(now())

  orders       Order[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  winnerUserId         String?
  winnerUser           User?        @relation("OrderWindowWinner", fields: [winnerUserId], references: [id])
  originalWinnerUserId String?
  lastSpunAt   DateTime?
  paid         Boolean      @default(false)
  shops        Shop[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@map("order_window")
}

model Order {
  id             String @id
  organizationId String
  userId         String
  windowId       String

  status       String // "pending" | "approved" | "rejected" | "cancelled"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdByAdmin  Boolean   @default(false)
  createdByUserId String?
  items        OrderItem[]
  orderWindow  OrderWindow  @relation(fields: [windowId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminUser    User?        @relation("AdminCreatedOrders", fields: [createdByUserId], references: [id])

  @@index([userId])
  @@index([windowId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([windowId, status])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id      String @id
  orderId String

  menuItemId String

  quantity  Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  // Replacement metadata
  replacementApplied     Boolean   @default(false)
  replacementAppliedAt   DateTime?
  replacementAppliedById String?
  replacementAppliedBy   User?     @relation("ReplacementAppliedBy", fields: [replacementAppliedById], references: [id])

  // Self-relations for replacements
  originalOrderItemId String?
  originalOrderItem   OrderItem?  @relation("ReplacementItems", fields: [originalOrderItemId], references: [id], onDelete: Cascade)
  replacementItems    OrderItem[] @relation("ReplacementItems")

  // Configured preferences
  replacementPreferences OrderItemReplacement[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_item")
}

model OrderItemReplacement {
  id          String   @id
  orderItemId String
  menuItemId  String
  quantity    Int
  createdAt   DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([menuItemId])
  @@map("order_item_replacement")
}

model MenuItem {
  id             String @id
  organizationId String

  name        String
  price       Decimal  @db.Decimal(10, 2)
  unit        String // "plate" | "piece" | "rs" | "glass"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems             OrderItem[]
  replacementPreferences OrderItemReplacement[]
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuCategory           MenuCategory           @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId         String
  shop                   Shop?                  @relation(fields: [shopId], references: [id])
  shopId                 String?
  imageUrl               String?

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([menuCategoryId])
  @@index([organizationId, isAvailable])
  @@map("menu_item")
}

model MenuCategory {
  id             String       @id
  organizationId String
  name           String // "Drinks", "Snacks", "Food"
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_category")
}

model Shop {
  id             String @id
  organizationId String

  name       String
  paymentUpi String?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  orderWindows OrderWindow[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("shop")
}
